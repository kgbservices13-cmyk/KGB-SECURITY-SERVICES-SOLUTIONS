---
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation = [
  { href: "#services", label: "Servicios" },
];

const serviceGroups = [
  {
    number: "01",
    title: "Protección en sitio",
    name: "Seguridad física",
    summary: "Personal preparado para controlar accesos, vigilar instalaciones y responder ante incidentes.",
    scope: "Control de accesos, rondas y prevención.",
    media: [
      { src: "/assets/servicio-seguridad-fisica.webp", alt: "Tres guardias KGB con casco, chaleco y equipo táctico frente a camionetas de la base de operaciones. Mensaje: Prevención real, no solo presencia." },
    ],
  },
  {
    number: "02",
    title: "Visibilidad y control",
    name: "Seguridad electrónica",
    summary: "Cámaras, alarmas y monitoreo para mantener los puntos críticos bajo observación.",
    scope: "Cámaras, sensores y monitoreo.",
    media: [
      { src: "/assets/servicio-centro-monitoreo.webp", alt: "Centro de monitoreo KGB con pantallas de cámaras sobre un puerto y operadores con diadema. Mensaje: Mientras tú duermes, KGB no parpadea." },
    ],
  },
  {
    number: "03",
    title: "Movimiento de mercancías",
    name: "Custodias para importación y exportación",
    summary: "Acompañamiento coordinado para proteger la carga durante el tránsito y el almacenamiento.",
    scope: "Custodias armadas, fluviales y de rutas.",
    media: [
      { src: "/assets/servicio-custodia-convoy.webp", alt: "Convoy de tres camionetas KGB con guardias armados y cascos avanzando por un camino de tierra en el campo." },
    ],
  },
  {
    number: "04",
    title: "Inspección especializada",
    name: "Servicios complementarios",
    summary: "Inspección con unidad canina K9, control de sustancias fiscalizadas y pruebas de poligrafía.",
    scope: "Revisión más precisa que la inspección visual.",
    media: [
      { src: "/assets/servicio-unidad-canina.webp", alt: "Guía KGB con un perro K9 revisando cajas de banano en un muelle. Mensaje: Tu primera línea de defensa tiene cuatro patas." },
    ],
  },
];

const serviceSlides = serviceGroups.flatMap((service, serviceIndex) =>
  service.media.map((image, part) => ({
    ...service,
    image,
    serviceIndex,
    part: part + 1,
    parts: service.media.length,
  })),
);
const firstSlideOf = serviceGroups.map((_, serviceIndex) => serviceSlides.findIndex((slide) => slide.serviceIndex === serviceIndex));

const serviceOptions = [
  "Seguridad física",
  "Seguridad electrónica",
  "Custodia de mercancía",
  "Inspección especializada",
  "Necesito orientación",
];

const contact = {
  whatsappPrimary: {
    display: "098 657 9409",
    href: "https://wa.me/593986579409?text=Hola%20KGB%2C%20quiero%20solicitar%20una%20cotizaci%C3%B3n.",
  },
  whatsappSecondary: {
    display: "098 551 1942",
    href: "https://wa.me/593985511942?text=Hola%20KGB%2C%20quiero%20solicitar%20una%20cotizaci%C3%B3n.",
  },
  conventional: {
    display: "04 501 4371",
    href: "tel:+59345014371",
  },
  managementEmail: "kguevara@kgb-security.com",
  commercialEmail: "tvelasquez@kgb-security.com",
};
---

<BaseLayout
  title="KGB Security Services & Solutions"
  description="Seguridad física, electrónica y custodia para operaciones de importación y exportación."
>
  <div class="site-shell" id="top">
    <header class="site-header">
      <a class="brand" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-v2.png" alt="KGB Security Services & Solutions" width="340" height="125" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
        <span>Menú</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>

      <nav class="main-navigation" id="main-navigation" aria-label="Navegación principal">
        <div class="main-navigation-links">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="header-actions">
          <span class="header-contact">
            <span class="header-contact-label">Contacto</span>
            <a class="header-phone" href={contact.whatsappPrimary.href} target="_blank" rel="noreferrer">{contact.whatsappPrimary.display}</a>
          </span>
          <a class="header-cta" href="#contact">Solicitar cotización <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>

    <div class="top-note" aria-label="Especialidad de KGB">
      <div class="top-note-inner">
        <span>Servicios de seguridad física y soluciones</span>
      </div>
    </div>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="kicker">Seguridad física</p>
          <h1 id="hero-title">Seguridad para tu carga, de origen a destino.</h1>
          <p class="hero-intro">
            Custodias armadas, candado satelital y unidad canina K9 para exportadores e importadores en Ecuador, del puerto al destino.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contact">Solicitar una evaluación <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#services">Ver los servicios <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof" aria-label="Lo que hacemos">
            <div><strong>Custodia armada</strong><small>terrestre y fluvial</small></div>
            <div><strong>Candado satelital</strong><small>para contenedores</small></div>
            <div><strong>Unidad canina K9</strong><small>inspección de carga</small></div>
          </div>
        </div>

        <figure class="hero-visual" data-reveal style="--reveal-delay: 90ms">
          <div class="hero-image-frame">
            <img class="hero-img-wide" src="/assets/servicio-listado-servicios.webp" alt="Afiche de KGB con el listado de servicios: seguridad física, seguridad electrónica y cámaras, candados satelitales, monitoreo, custodias armadas para importación y exportación, custodias fluviales, inspecciones K9 y pruebas poligráficas. Incluye guardias, un camión, contenedores en un puerto y una camioneta KGB." width="1153" height="824" loading="eager" fetchpriority="high" />
          </div>
          <figcaption>Seguridad física · tecnología · custodia</figcaption>
        </figure>
      </section>

      <section class="services-section" id="services" aria-labelledby="services-title">
        <div class="section-intro">
          <h2 id="services-title">Servicios de seguridad para instalaciones, carga e inspecciones.</h2>
        </div>

        <div class="svc-tabs" data-svc-tabs>
          <div class="svc-nav" aria-label="Ir a un servicio">
            {serviceGroups.map((service, index) => (
              <button class="svc-tab" type="button" data-slide={firstSlideOf[index]} aria-current={index === 0 ? "true" : undefined}>
                <span class="svc-tab-text"><small>{service.title}</small><strong>{service.name}</strong></span>
              </button>
            ))}
          </div>

          <div class="svc-carousel" role="region" aria-roledescription="carrusel" aria-label="Servicios de KGB">
            <div class="svc-stage" tabindex="0">
              {serviceSlides.map((slide, index) => (
                <article class={slide.image.width ? "svc-panel svc-panel-wide" : "svc-panel"} role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} de ${serviceSlides.length}`} data-service={slide.serviceIndex}>
                  <div class="svc-media">
                    <div class="service-shot-frame">
                      <img src={slide.image.src} alt={slide.image.alt} width={slide.image.width ?? 1192} height={slide.image.height ?? 1191} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                    </div>
                  </div>
                  <div class="svc-detail">
                    <p class="svc-eyebrow">{slide.title}</p>
                    <h3>{slide.name}</h3>
                    <p class="svc-summary">{slide.summary}</p>
                    <p class="svc-scope">{slide.scope}</p>
                    <a class="text-link" href="#contact" aria-label={`Solicitar información sobre ${slide.name}`}>Cotizar este servicio <span aria-hidden="true">↗</span></a>
                  </div>
                </article>
              ))}
            </div>

            <div class="svc-controls">
              <button class="svc-arrow" type="button" data-dir="-1" aria-label="Servicio anterior"><span aria-hidden="true">←</span></button>
              <span class="svc-counter" aria-live="polite"><strong data-svc-current>01</strong> / {String(serviceSlides.length).padStart(2, "0")}</span>
              <button class="svc-arrow" type="button" data-dir="1" aria-label="Servicio siguiente"><span aria-hidden="true">→</span></button>
            </div>
          </div>
        </div>
      </section>

      <section class="extra-section" id="extra" aria-labelledby="extra-title">
        <figure class="extra-figure">
          <div class="service-shot-frame">
            <img src="/assets/servicio-candado-satelital.webp" alt="Dos agentes KGB anotando junto a un contenedor con candado satelital y una camioneta KGB en el puerto. Mensaje: Candado satelital KGB, tu contenedor bajo llave y bajo control." width="1192" height="1191" loading="lazy" decoding="async" />
          </div>
        </figure>
        <div class="extra-copy">
          <h2 id="extra-title">Candado satelital: tu contenedor, bajo llave y bajo control.</h2>
          <p>Cada contenedor viaja cerrado con candado satelital durante el recorrido.</p>
          <a class="text-link" href="#contact">Cotizar el candado satelital <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="contact-copy">
          <h2 id="contact-title">Hablemos de tu operación.</h2>
          <p>Cuéntanos qué necesitas proteger y la ruta de tu carga.</p>
          <div class="contact-details" aria-label="Canales de contacto">
            <div class="contact-detail">
              <span>Teléfono convencional</span>
              <a href={contact.conventional.href}>{contact.conventional.display}</a>
            </div>
            <div class="contact-detail">
              <span>Celulares</span>
              <ul class="contact-detail-list">
                <li><a href={contact.whatsappPrimary.href} target="_blank" rel="noreferrer">{contact.whatsappPrimary.display}</a></li>
                <li><a href={contact.whatsappSecondary.href} target="_blank" rel="noreferrer">{contact.whatsappSecondary.display}</a></li>
              </ul>
            </div>
            <div class="contact-detail">
              <span>Gerencia</span>
              <a href={`mailto:${contact.managementEmail}`}>{contact.managementEmail}</a>
            </div>
            <div class="contact-detail">
              <span>Comercial</span>
              <a href={`mailto:${contact.commercialEmail}`}>{contact.commercialEmail}</a>
            </div>
          </div>
        </div>

        <form class="contact-form" id="contact-form">
          <div class="form-heading"><strong>Solicitar una evaluación</strong><span>Te responderemos con los siguientes pasos.</span></div>
          <div class="form-field">
            <label for="name">Nombre de contacto</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" required />
          </div>
          <div class="form-field">
            <label for="company">Empresa</label>
            <input id="company" name="company" type="text" autocomplete="organization" placeholder="Nombre de tu empresa" required />
          </div>
          <div class="form-field form-field-wide">
            <label for="service">Servicio que necesitas</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Selecciona una opción</option>
              {serviceOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="message">Contexto de la operación</label>
            <textarea id="message" name="message" rows="5" placeholder="Ruta, tipo de mercancía, tiempos o cualquier detalle útil." required></textarea>
          </div>
          <div class="form-submit">
            <button class="button button-primary" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button>
            <p class="form-status" id="form-status" aria-live="polite"></p>
          </div>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand brand-footer" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-v2.png" alt="KGB Security Services & Solutions" width="300" height="110" />
      </a>
      <div class="footer-links">
        <a href={contact.whatsappPrimary.href} target="_blank" rel="noreferrer">WhatsApp {contact.whatsappPrimary.display}</a>
        <a href={contact.conventional.href}>Teléfono {contact.conventional.display}</a>
        <a href={`mailto:${contact.commercialEmail}`}>{contact.commercialEmail}</a>
        <a href="https://www.instagram.com/kgb.ec/" target="_blank" rel="noreferrer">Instagram @kgb.ec</a>
      </div>
      <p class="footer-legal">© {new Date().getFullYear()} KGB Security Services & Solutions</p>
    </footer>
  </div>
</BaseLayout>

<script>
  const svcRoot = document.querySelector<HTMLElement>("[data-svc-tabs]");
  const svcStage = svcRoot?.querySelector<HTMLElement>(".svc-stage");

  if (svcRoot && svcStage) {
    const tabs = Array.from(svcRoot.querySelectorAll<HTMLButtonElement>(".svc-tab"));
    const slides = Array.from(svcStage.querySelectorAll<HTMLElement>(".svc-panel"));
    const counter = svcRoot.querySelector<HTMLElement>("[data-svc-current]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;

    let touching = false;
    let settle: number | undefined;

    const goTo = (index: number) => {
      const target = (index + slides.length) % slides.length;
      const left = target * svcStage.clientWidth;
      svcStage.scrollTo({ left, behavior: reduceMotion ? "auto" : "smooth" });
      // Some browsers drop a smooth scroll that starts right after another; land it if so.
      window.clearTimeout(settle);
      settle = window.setTimeout(() => {
        if (!touching && Math.abs(svcStage.scrollLeft - left) > 2) svcStage.scrollTo({ left, behavior: "auto" });
      }, 1000);
    };

    const sync = () => {
      const index = Math.round(svcStage.scrollLeft / svcStage.clientWidth);
      if (index === current || index < 0 || index >= slides.length) return;
      current = index;
      const service = slides[index].dataset.service;
      tabs.forEach((tab, i) => {
        if (String(i) === service) tab.setAttribute("aria-current", "true");
        else tab.removeAttribute("aria-current");
      });
      if (counter) counter.textContent = String(index + 1).padStart(2, "0");
    };


    svcStage.addEventListener("scroll", sync, { passive: true });

    tabs.forEach((tab) => tab.addEventListener("click", () => { goTo(Number(tab.dataset.slide)); }));
    svcRoot.querySelectorAll<HTMLButtonElement>(".svc-arrow").forEach((button) => {
      button.addEventListener("click", () => { goTo(current + Number(button.dataset.dir)); });
    });
    svcStage.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(current + (event.key === "ArrowRight" ? 1 : -1));
      }
    });
    svcStage.addEventListener("pointerdown", () => { touching = true; });
    window.addEventListener("pointerup", () => { touching = false; });
    window.addEventListener("pointercancel", () => { touching = false; });
    window.addEventListener("resize", () => svcStage.scrollTo({ left: current * svcStage.clientWidth, behavior: "auto" }));
  }
</script>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>(".main-navigation");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    navigation?.classList.toggle("is-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuToggle?.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
    });
  });

  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  const formStatus = document.querySelector<HTMLElement>("#form-status");
  const commercialEmail = "tvelasquez@kgb-security.com";
  const managementEmail = "kguevara@kgb-security.com";

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const formData = new FormData(contactForm);
    const name = String(formData.get("name") ?? "").trim();
    const company = String(formData.get("company") ?? "").trim();
    const service = String(formData.get("service") ?? "").trim();
    const message = String(formData.get("message") ?? "").trim();
    const subject = `Solicitud de cotización — ${company || name || "Nuevo contacto"}`;
    const body = [
      "Hola KGB,",
      "",
      "Me gustaría solicitar información sobre sus servicios.",
      "",
      `Nombre de contacto: ${name || "No especificado"}`,
      `Empresa: ${company || "No especificada"}`,
      `Servicio requerido: ${service || "No especificado"}`,
      "",
      "Contexto de la operación:",
      message || "No especificado",
    ].join("\r\n");

    // mailto: usa la codificación de RFC 6068 (percent-encoding), no la de
    // application/x-www-form-urlencoded que emplea URLSearchParams — esta
    // última convierte los espacios en "+" y los clientes de correo no los
    // interpretan, mostrando el texto con "+" en vez de espacios.
    const mailtoParams = [
      ["cc", managementEmail],
      ["subject", subject],
      ["body", body],
    ]
      .map(([key, value]) => `${key}=${encodeURIComponent(value)}`)
      .join("&");

    if (formStatus) {
      formStatus.textContent = "Abriendo tu correo para completar el envío…";
    }

    window.location.href = `mailto:${commercialEmail}?${mailtoParams}`;
  });
</script>
