---
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation = [
  { href: "#fisica", label: "Seguridad física" },
  { href: "#candado", label: "Candado satelital" },
  { href: "#custodia", label: "Custodia armada" },
];

// Fotos del carrusel de custodia armada (camionetas y seguridad).
// Para agregar una foto: copiarla a public/assets/ (cuadrada, sin recortar) y añadir una línea aquí.
const custodyPhotos = [
  { src: "/assets/servicio-custodia-convoy.webp", alt: "Convoy de tres camionetas KGB con guardias armados y cascos avanzando por un camino de tierra en el campo.", title: "Custodia armada en ruta", text: "Escolta armada en convoy para tu carga terrestre, con camionetas y guardias KGB de origen a destino." },
  { src: "/assets/servicio-seguridad-fisica.webp", alt: "Tres guardias KGB con casco, chaleco y equipo táctico frente a camionetas de la base de operaciones. Mensaje: Prevención real, no solo presencia.", title: "Prevención real", text: "Guardias con equipo táctico y base de operaciones para proteger tu carga y tus instalaciones, no solo hacer presencia." },
];

// "Más servicios": cada fila se abre al tocarla. Todas las imágenes cuadradas y sin recortar.
const moreServices = [
  {
    name: "Seguridad electrónica y monitoreo",
    text: "Cámaras, sensores y monitoreo.",
    images: [
      { src: "/assets/servicio-centro-monitoreo.webp", alt: "Centro de monitoreo KGB con pantallas de cámaras sobre un puerto y operadores con diadema. Mensaje: Mientras tú duermes, KGB no parpadea.", title: "Seguridad electrónica y monitoreo", text: "Cámaras, sensores y operadores vigilando tu carga y tus instalaciones, incluso mientras tú descansas." },
    ],
  },
  {
    name: "Inspección K9 y de contenedores",
    text: "Inspecciones K9 de sustancias sujetas a fiscalización.",
    images: [
      { src: "/assets/servicio-unidad-canina.webp", alt: "Guía KGB con un perro K9 revisando cajas de banano en un muelle. Mensaje: Tu primera línea de defensa tiene cuatro patas.", title: "K9 en banano", text: "Guía y perro K9 revisan la carga de banano en el muelle en busca de sustancias sujetas a fiscalización." },
      { src: "/assets/servicio-unidad-canina-cacao.webp", alt: "Guía KGB con un perro K9 revisando sacos de cacao en un puerto. Mensaje: Tu primera línea de defensa tiene cuatro patas.", title: "K9 en cacao", text: "Inspección K9 de sacos de cacao en puerto para detectar sustancias sujetas a fiscalización." },
      { src: "/assets/servicio-unidad-canina-camaron.webp", alt: "Guía KGB con un perro K9 revisando cajas de camarón junto a contenedores. Mensaje: Tu primera línea de defensa tiene cuatro patas.", title: "K9 en camarón", text: "Inspección K9 de cajas de camarón junto a los contenedores, antes de que la carga salga." },
      { src: "/assets/servicio-inspeccion-contenedores.webp", alt: "Personal KGB con chaleco, linterna y tableta revisando un contenedor en el puerto. Mensaje: Inspección y verificación de contenedores.", title: "Inspección de contenedores", text: "Revisión y verificación del contenedor en el puerto, con registro de lo inspeccionado." },
    ],
  },
  {
    name: "Pruebas poligráficas",
    text: "",
    images: [
      { src: "/assets/servicio-poligrafia.webp", alt: "Examen de poligrafía en una oficina con una examinadora KGB tomando notas. Mensaje: La confianza se gana. La verdad se comprueba.", title: "Pruebas poligráficas", text: "Exámenes de poligrafía aplicados por personal KGB para comprobar la confianza de tu equipo." },
    ],
  },
];

// Servicios complementarios: una diapositiva por foto, con el nombre y la descripción de su servicio.
const complementary = moreServices.flatMap((service) => service.images.map((image) => ({ ...image, name: service.name, text: service.text, backTitle: image.title, backText: image.text })));

// Lista de la primera sección: los servicios del afiche, escritos como texto y enlazados a su sección.
const heroServices = [
  { href: "#fisica", label: "Seguridad física" },
  { href: "#mas-servicios", label: "Seguridad electrónica y cámaras" },
  { href: "#candado", label: "Candados satelitales" },
  { href: "#mas-servicios", label: "Servicio de monitoreo" },
  { href: "#custodia", label: "Custodias armadas para importación y exportación" },
  { href: "#custodia", label: "Custodias fluviales" },
  { href: "#mas-servicios", label: "Inspecciones K9 de sustancias sujetas a fiscalización" },
  { href: "#mas-servicios", label: "Pruebas poligráficas" },
];

const serviceOptions = [
  "Seguridad física",
  "Custodia armada",
  "Candado satelital",
  "Seguridad electrónica y monitoreo",
  "Inspección K9 y de contenedores",
  "Pruebas poligráficas",
  "Otro servicio u orientación",
];

const contact = {
  whatsappPrimary: {
    display: "098 657 9409",
    href: "https://wa.me/593986579409?text=Hola%20KGB%2C%20quiero%20solicitar%20una%20cotizaci%C3%B3n.",
  },
  whatsappSecondary: {
    display: "098 551 1942",
    href: "https://wa.me/593985511942?text=Hola%20KGB%2C%20quiero%20solicitar%20una%20cotizaci%C3%B3n.",
  },
  conventional: {
    display: "04 501 4371",
    href: "tel:+59345014371",
  },
  managementEmail: "kguevara@kgb-security.com",
  commercialEmail: "tvelasquez@kgb-security.com",
};
