<script>
  document.querySelectorAll<HTMLButtonElement>(".flip").forEach((card) => {
    const back = card.querySelector<HTMLElement>(".flip-back");
    const inStrip = card.closest(".marquee") !== null;
    let resume: number | undefined;
    card.addEventListener("click", () => {
      const flipped = card.classList.toggle("is-flipped");
      card.setAttribute("aria-pressed", String(flipped));
      back?.setAttribute("aria-hidden", String(!flipped));
      // In the moving strip a description stays open only a few seconds, then the strip resumes.
      window.clearTimeout(resume);
      if (inStrip && flipped) resume = window.setTimeout(() => card.click(), 6000);
    });
  });

  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const galleryTrack = gallery?.querySelector<HTMLElement>(".gallery-track");

  if (gallery && galleryTrack) {
    const items = Array.from(galleryTrack.querySelectorAll<HTMLElement>(".gallery-item"));
    const arrows = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".viewer-arrow"));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".viewer-thumb"));
    const thumbsBox = gallery.querySelector<HTMLElement>("[data-gallery-thumbs]");
    const count = gallery.querySelector<HTMLElement>("[data-gallery-current]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const step = () => items[0]?.getBoundingClientRect().width ?? galleryTrack.clientWidth;
    let settle: number | undefined;

    const show = (index: number) => {
      if (count) count.textContent = String(index + 1).padStart(2, "0");
      thumbs.forEach((thumb, i) => {
        if (i === index) thumb.setAttribute("aria-current", "true");
        else thumb.removeAttribute("aria-current");
      });
      arrows[0].disabled = index <= 0;
      arrows[1].disabled = index >= items.length - 1;
    };

    const goTo = (requested: number) => {
      const index = Math.min(items.length - 1, Math.max(0, requested));
      // Turn any open description back to its photo before moving on.
      galleryTrack.querySelectorAll<HTMLButtonElement>(".flip.is-flipped").forEach((card) => card.click());
      const target = index * step();
      galleryTrack.scrollTo({ left: target, behavior: reduceMotion ? "auto" : "smooth" });
      show(index);
      // Some browsers drop a smooth scroll that starts right after another; land it if so.
      window.clearTimeout(settle);
      settle = window.setTimeout(() => {
        if (Math.abs(galleryTrack.scrollLeft - target) > 2) galleryTrack.scrollTo({ left: target, behavior: "auto" });
      }, 900);
    };

    const current = () => Math.round(galleryTrack.scrollLeft / step());

    // One photo only: nothing to browse.
    if (items.length < 2) {
      arrows.forEach((arrow) => (arrow.hidden = true));
      if (thumbsBox) thumbsBox.hidden = true;
    }

    arrows.forEach((arrow) => arrow.addEventListener("click", () => goTo(current() + Number(arrow.dataset.dir))));
    thumbs.forEach((thumb) => thumb.addEventListener("click", () => goTo(Number(thumb.dataset.index))));
    galleryTrack.addEventListener("scroll", () => show(current()), { passive: true });
    galleryTrack.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(current() + (event.key === "ArrowRight" ? 1 : -1));
      }
    });
    window.addEventListener("resize", () => goTo(current()));
    show(0);
  }
</script>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>(".main-navigation");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    navigation?.classList.toggle("is-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuToggle?.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
    });
  });

  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  const formStatus = document.querySelector<HTMLElement>("#form-status");
  const commercialEmail = "tvelasquez@kgb-security.com";
  const managementEmail = "kguevara@kgb-security.com";

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const formData = new FormData(contactForm);
    const name = String(formData.get("name") ?? "").trim();
    const company = String(formData.get("company") ?? "").trim();
    const service = String(formData.get("service") ?? "").trim();
    const message = String(formData.get("message") ?? "").trim();
    const subject = `Solicitud de cotización — ${company || name || "Nuevo contacto"}`;
    const body = [
      "Hola KGB,",
      "",
      "Me gustaría solicitar información sobre sus servicios.",
      "",
      `Nombre de contacto: ${name || "No especificado"}`,
      `Empresa: ${company || "No especificada"}`,
      `Servicio requerido: ${service || "No especificado"}`,
      "",
      "Contexto de la operación:",
      message || "No especificado",
    ].join("\r\n");

    // mailto: usa la codificación de RFC 6068 (percent-encoding), no la de
    // application/x-www-form-urlencoded que emplea URLSearchParams — esta
    // última convierte los espacios en "+" y los clientes de correo no los
    // interpretan, mostrando el texto con "+" en vez de espacios.
    const mailtoParams = [
      ["cc", managementEmail],
      ["subject", subject],
      ["body", body],
    ]
      .map(([key, value]) => `${key}=${encodeURIComponent(value)}`)
      .join("&");

    if (formStatus) {
      formStatus.textContent = "Abriendo tu correo para completar el envío…";
    }

    window.location.href = `mailto:${commercialEmail}?${mailtoParams}`;
  });
</script>
